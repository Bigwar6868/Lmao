{
  "autoUpdatesChannel": "latest",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(git *)", "Bash(gh *)", "Bash(npm *)", "Bash(npx *)",
      "Bash(node *)", "Bash(cat *)", "Bash(ls *)", "Bash(find *)",
      "Bash(grep *)", "Bash(rg *)", "Bash(mkdir *)", "Bash(cp *)",
      "Bash(mv *)", "Bash(rm *)", "Bash(echo *)", "Bash(python *)",
      "Bash(pip *)", "Bash(curl *)", "Bash(jq *)", "Bash(tree *)"
    ],
    "deny": []
  },
  "env": {
    "MCP_TIMEOUT": "15000",
    "MAX_MCP_OUTPUT_TOKENS": "25000"
  },
  "mcpServers": {
    "alpaca": {
      "command": "uvx",
      "args": ["--from", "alpaca-mcp-server", "alpaca-mcp-server", "run"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_API_SECRET": "${ALPACA_API_SECRET}",
        "ALPACA_PAPER": "true"
      }
    }
  }
}
