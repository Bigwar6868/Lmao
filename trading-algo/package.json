{
  "name": "trading-algo",
  "version": "2.1.0",
  "description": "Self-evolving multi-asset trading algorithm system",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "backtest": "tsx src/scripts/backtest.ts",
    "paper-trade": "tsx src/scripts/paper-trade.ts",
    "analyze": "tsx src/scripts/analyze.ts",
    "evolve": "tsx src/scripts/evolve.ts",
    "diagnose": "tsx src/scripts/diagnose.ts",
    "scan": "tsx src/scripts/scan.ts",
    "auto-trade": "tsx src/scripts/auto-trade.ts",
    "seed-data": "tsx src/scripts/seed-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "node scripts/bundle.mjs",
    "release:build": "node scripts/bundle.mjs && node scripts/package-release.mjs",
    "whats-new": "tsx src/scripts/whats-new.ts"
  },
  "pkg": {
    "assets": [
      "data/**/*",
      "dist/node_modules/**/*"
    ],
    "scripts": [
      "dist/backtest.cjs",
      "dist/paper-trade.cjs",
      "dist/auto-trade.cjs",
      "dist/analyze.cjs",
      "dist/evolve.cjs",
      "dist/diagnose.cjs",
      "dist/scan.cjs",
      "dist/seed-data.cjs",
      "dist/index.cjs"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.76",
    "axios": "^1.7.0",
    "ccxt": "^4.4.0",
    "dotenv": "^16.4.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "trading-signals": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
