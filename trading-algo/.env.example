# Trading Algorithm Configuration
# Copy this file to .env and fill in your API keys

# Alpha Vantage (free: 25 requests/day) - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo

# FRED API (free, unlimited) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Exchange API Keys
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=

# OANDA v20 (forex + metals) - https://www.oanda.com/
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_IS_LIVE=false

# Alpaca (stocks/crypto) - https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET=
ALPACA_PAPER=false

# Trading Configuration
TRADING_MODE=live
LOG_LEVEL=info
DEFAULT_TIMEFRAME=1h
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE_PCT=5
MAX_DRAWDOWN_PCT=20
